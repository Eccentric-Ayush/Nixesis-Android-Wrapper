# Use the deployed backend's API base path, without a trailing slash.
# Example format: https://api.example.com/nixesis-api
VITE_API_BASE_URL=https://YOUR_BACKEND_HOST/nixesis-api

# Required by the existing Manus OAuth sign-in flow.
VITE_APP_ID=YOUR_MANUS_APP_ID
VITE_OAUTH_PORTAL_URL=https://YOUR_OAUTH_PORTAL

# API server settings: configure these on the backend host, not in the Android
# app. DATABASE_URL must point to the existing MySQL-compatible database.
OAUTH_SERVER_URL=https://YOUR_OAUTH_SERVER
# Set DATABASE_URL and JWT_SECRET privately in the backend's secret manager.

# Optional extra browser origins for cross-origin backend requests.
# The Capacitor local origins are allowed by the backend code by default.
CORS_ALLOWED_ORIGINS=